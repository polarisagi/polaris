{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Polaris",
  "version": "0.1.0",
  "identifier": "online.polarisagi.polaris.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Polaris",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "visible": true,
        "url": "boot.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "appimage"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "Polaris 桌面外壳",
    "longDescription": "Polaris 自托管 AI Agent 的桌面外壳。守护进程与本外壳分开安装（见 ADR-0096 决策四）。"
  }
}
