{
  "title": "feed_fetch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "url"
  ],
  "properties": {
    "url": {
      "type": "string",
      "description": "RSS / Atom / JSON Feed 订阅源 URL"
    },
    "max_items": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "default": 30,
      "description": "返回条目最大数量，默认 30，上限 200"
    },
    "since": {
      "type": "string",
      "description": "可选：RFC3339 时间戳，只保留在此时间之后发布的条目"
    }
  }
}
