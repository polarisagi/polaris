{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "switch_model",
  "description": "请求在下一轮切换使用的模型或思考档位。",
  "type": "object",
  "properties": {
    "ref": {
      "type": "string",
      "description": "<provider_id>/<model_id> 或池名（general/reasoning/default/budget）"
    },
    "pool": {
      "type": "string",
      "description": "角色池（未给 ref 时用）"
    },
    "thinking": {
      "type": "string",
      "description": "none/low/medium/high"
    }
  }
}
