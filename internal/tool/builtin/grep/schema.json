{
  "title": "grep",
  "type": "object",
  "properties": {
    "pattern": {
      "type": "string",
      "description": "正则（Go 语法）"
    },
    "path": {
      "type": "string",
      "description": "搜索根目录，默认全部允许路径"
    },
    "glob": {
      "type": "string",
      "description": "文件名过滤，如 \"*.go\""
    },
    "output_mode": {
      "type": "string",
      "enum": [
        "content",
        "files_with_matches",
        "count"
      ],
      "description": "默认 files_with_matches"
    },
    "context_before": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "description": "前置上下文行数（-B）"
    },
    "context_after": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "description": "后置上下文行数（-A）"
    },
    "case_insensitive": {
      "type": "boolean",
      "description": "忽略大小写"
    },
    "head_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "description": "最大条数，默认 250"
    }
  },
  "required": [
    "pattern"
  ]
}
