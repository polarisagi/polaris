{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "file_edit",
  "description": "为项目文件准备、应用、检查或恢复有持久事务记录的跨文件编辑。",
  "type": "object",
  "properties": {
    "path": { "type": "string", "description": "绝对项目根目录。" },
    "action": { "type": "string", "enum": ["preview", "apply", "status", "recover"] },
    "transaction_id": { "type": "string", "pattern": "^[a-fA-F0-9]{32}$" },
    "edits": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "content": { "type": "string" },
          "delete": { "type": "boolean" },
          "expected_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "expected_absent": { "type": "boolean" }
        },
        "required": ["path"],
        "additionalProperties": false
      }
    }
  },
  "required": ["path", "action"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "preview" } } },
      "then": { "required": ["edits"], "not": { "required": ["transaction_id"] } }
    },
    {
      "if": { "properties": { "action": { "enum": ["apply", "status", "recover"] } } },
      "then": { "required": ["transaction_id"], "not": { "required": ["edits"] } }
    }
  ]
}
